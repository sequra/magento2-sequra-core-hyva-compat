<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="payment_method_is_active">
        <observer name="hyva_sequra_hide_on_unconnected_store"
                  instance="Hyva\SequraCoreCheckout\Observer\HideSequraOnUnconnectedStore"/>
        <observer name="hyva_sequra_hide_without_products"
                  instance="Hyva\SequraCoreCheckout\Observer\HideSequraWithoutProducts"/>
    </event>
</config>
